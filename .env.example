# =========================================================================
# 📖 [개발 서버 실행 가이드 / How to Run Development Server]
# =========================================================================
#
# 1. 패키지 의존성 설치:
#    $ npm install
#
# 2. 로컬 개발 서버 실행:
#    $ npm run docs:dev
#    (또는 $ npx vitepress dev)
#
# 3. 특정 포트 또는 외부 IP 접속 허용 실행:
#    - 포트 지정: $ npm run docs:dev -- --port 5173
#    - 외부 접속: $ npm run docs:dev -- --host 0.0.0.0
#
# 4. 브라우저 접속 URL:
#    - 로컬 접속: http://localhost:5173 (또는 http://127.0.0.1:5173)
#
# 5. 프로덕션 빌드 및 로컬 미리보기 (검증용):
#    - 빌드:     $ npm run docs:build
#    - 미리보기: $ npm run docs:preview
#
# 6. 개발 서버 종료:
#    - 터미널에서 Ctrl + C 입력
#
# =========================================================================
# 🛠️ 개발 서버 환경 설정 템플릿 (.env.example)
# =========================================================================
# 본 파일을 복사하여 .env 파일을 생성하고 환경에 맞게 값을 설정하십시오.

# 애플리케이션 환경 모드 (development | production | test)
VITE_APP_ENV=development

# 개발 서버 호스트 및 포트 설정
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173

# 개발자 디버그 모드 및 상세 로그 출력 여부 (true | false)
VITE_ENABLE_DEBUG_LOG=true

# =========================================================================
# 🔐 사이트 접근 제어 및 관리자 권한 설정
# =========================================================================
VITE_ADMIN_IPS=127.0.0.1, localhost, ::1
VITE_ALLOWED_IPS=127.0.0.1, localhost, ::1
VITE_SECURE_CODE=dev1234

# =========================================================================
# 🚀 배포 및 원격 저장소 정보
# =========================================================================
VITE_DEPLOY_TARGET=vercel
VITE_VERCEL_PROJECT_URL=https://vercel.com/daoltech-projects/dev-knowledge-db
VITE_GITHUB_REPO_URL=https://github.com/poohaman1/dev-knowledge-db.git
